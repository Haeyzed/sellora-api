<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integrations">
            <directory>integrations/OpenExchangeRates/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>modules</directory>
            <directory>integrations</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="central"/>
        <env name="DB_DATABASE" value="sellora_central_testing"/>
        <env name="DB_URL" value=""/>
        <env name="TENANT_DATABASE_PREFIX" value="sellora_testing_tenant_"/>
        <env name="PLATFORM_CENTRAL_DOMAINS" value="localhost"/>
        <!-- Tests never reach cloud storage, whatever .env or the shell says: every disk is local, and no cloud credentials are set (TestCase also swaps any disk that isn't local, and CloudStorageTest checks both). -->
        <env name="FILESYSTEM_DISK" value="local" force="true"/>
        <env name="STOREFRONT_IMAGE_DISK" value="public" force="true"/>
        <env name="MEDIA_DISK" value="public" force="true"/>
        <env name="CUSTOMER_DATA_EXPORT_DISK" value="local" force="true"/>
        <env name="STORE_EXPORT_DISK" value="store_exports" force="true"/>
        <env name="STORE_EXPORT_AFRICA_DRIVER" value="local" force="true"/>
        <env name="STORE_EXPORT_EU_DRIVER" value="local" force="true"/>
        <env name="STORE_EXPORT_US_DRIVER" value="local" force="true"/>
        <env name="STORE_EXPORT_AFRICA_KEY" value="" force="true"/>
        <env name="STORE_EXPORT_AFRICA_SECRET" value="" force="true"/>
        <env name="STORE_EXPORT_AFRICA_BUCKET" value="" force="true"/>
        <env name="STORE_EXPORT_EU_KEY" value="" force="true"/>
        <env name="STORE_EXPORT_EU_SECRET" value="" force="true"/>
        <env name="STORE_EXPORT_EU_BUCKET" value="" force="true"/>
        <env name="STORE_EXPORT_US_KEY" value="" force="true"/>
        <env name="STORE_EXPORT_US_SECRET" value="" force="true"/>
        <env name="STORE_EXPORT_US_BUCKET" value="" force="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="" force="true"/>
        <env name="AWS_SESSION_TOKEN" value="" force="true"/>
        <env name="AWS_BUCKET" value="" force="true"/>
        <env name="AWS_URL" value="" force="true"/>
        <env name="AWS_ENDPOINT" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SCOUT_DRIVER" value="null"/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
