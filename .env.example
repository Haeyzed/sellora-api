# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
APP_NAME=Sellora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ==========================================
# MULTI-TENANCY & DOMAIN CONFIGURATION
# ==========================================
PLATFORM_DOMAIN=sellora-api.test
PLATFORM_CENTRAL_DOMAINS=sellora-api.test,localhost,127.0.0.1
TENANT_DATABASE_PREFIX=sellora_tenant_
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Regions & Cloud Regions (config platform.regions, e.g. af-south-1)
REGION_AFRICA_CLOUD_REGION=
REGION_EU_CLOUD_REGION=
REGION_US_CLOUD_REGION=

# API & Store Registration Settings
# The API docs' "Try it" (on a central domain) calling store APIs. Only ever on when APP_ENV=local;
# set to false to turn it off there too. Outside local it is always off.
# API_DOCS_TRY_IT=false
STORE_REGISTRATION_PLAN=free
STORE_REGISTRATION_CODE_EXPIRE_MINUTES=60
STORE_REGISTRATION_MAX_STORES_PER_EMAIL=3

# ==========================================
# APPLICATION URLS & ACTION ENDPOINTS
# ==========================================
PLATFORM_ADMIN_PASSWORD_RESET_URL="http://localhost:3000/reset-password?token={token}&email={email}"
STAFF_PASSWORD_RESET_URL="https://{domain}/admin/reset-password?token={token}&email={email}"
CUSTOMER_PASSWORD_RESET_URL="https://{domain}/reset-password?token={token}&email={email}"
STAFF_INVITATION_URL="https://{domain}/admin/accept-invitation?token={token}"
OWNERSHIP_TRANSFER_URL="https://{domain}/admin/ownership-transfer?transfer={transfer}"
STORE_DASHBOARD_URL="https://{domain}/admin"

# Store Export URLs
STORE_EXPORT_PLATFORM_URL=http://localhost:3000/stores/{store}/exports/{export}
STORE_EXPORT_STORE_URL="https://{domain}/admin/settings/exports/{export}"

# ==========================================
# STORE EXPORTS CONFIGURATION
# Each region's export disk: "local" (storage/app/store-exports/<region>) or "s3" with the bucket below.
# The bucket lives in the region's REGION_<REGION>_CLOUD_REGION; left empty, AWS_DEFAULT_REGION.
# Exports are built on the "bulk" queue, so a worker must listen on it: queue:work --queue=default,bulk
# ==========================================
STORE_EXPORT_AFRICA_DRIVER=local
STORE_EXPORT_AFRICA_BUCKET=
STORE_EXPORT_EU_DRIVER=local
STORE_EXPORT_EU_BUCKET=
STORE_EXPORT_US_DRIVER=local
STORE_EXPORT_US_BUCKET=

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sellora_central
DB_USERNAME=postgres
DB_PASSWORD=

# ==========================================
# CACHE, SESSION & QUEUE DRIVERS
# ==========================================
CACHE_STORE=redis
# CACHE_PREFIX=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=redis

# ==========================================
# REDIS & MEMCACHED CONFIGURATION
# ==========================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# ==========================================
# AUTHENTICATION & SANCTUM
# ==========================================
SANCTUM_TOKEN_EXPIRATION_MINUTES=1440

# ==========================================
# SEARCH & SCOUT
# ==========================================
SCOUT_DRIVER=database
SCOUT_QUEUE=true

# ==========================================
# LOGGING & MONITORING
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

TELESCOPE_ENABLED=true

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# ==========================================
# MAIL CONFIGURATION
# ==========================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# AWS / CLOUD STORAGE
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# AI & TRANSLATION DRIVERS
# ==========================================
# Global Settings
TRANSLATION_DEFAULT_DRIVER=ollama
TRANSLATION_SOURCE_LANGUAGE=en

# Ollama (Local AI)
OLLAMA_MODEL=llama3
OLLAMA_API_URL=http://localhost:11434/v1

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key

# Google & DeepL
GOOGLE_API_KEY=your-google-api-key
DEEPL_API_KEY=your-deepl-api-key

# ==========================================
# FRONTEND / VITE
# ==========================================
VITE_APP_NAME="${APP_NAME}"

# ==========================================
# EXCHANGE RATES (Open Exchange Rates, platform-wide)
# ==========================================
# The app ID is a secret: set it in .env only. The free plan is enough for development.
OPEN_EXCHANGE_RATES_APP_ID=
# EXCHANGE_RATES_ALERT_AFTER_HOURS=12
# EXCHANGE_RATES_STALE_AFTER_HOURS=48
